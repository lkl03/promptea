# Promptea — environment variables (v1.8.9)
#
# Copy to .env.local for local development. NEVER commit real values.
# In production these live in Vercel → Project → Settings → Environment
# Variables. Server-only values must NOT start with NEXT_PUBLIC_.

# ─── Claude (Anthropic) — v1.8.9 ─────────────────────────────────────────────
# Server-only secret. Without it every AI feature falls back to Promptea's own
# engine (the Prompt flow shows its basic plan). Create it in
# console.anthropic.com → API keys, ideally in a workspace with its own spend
# limit (second barrier, see docs/ops/ai-budget.md).
ANTHROPIC_API_KEY=

# Hard monthly cap. Calls stop at AI_MONTHLY_BUDGET_USD × AI_BUDGET_SAFETY_RATIO
# ($90 with the defaults), counting the WORST case of each call before making it.
AI_MONTHLY_BUDGET_USD=100
AI_BUDGET_SAFETY_RATIO=0.9
# Per UTC day (default: the monthly stop ÷ 15 = $6), so one day cannot burn the month.
# AI_DAILY_BUDGET_USD=6
# Per visitor (hashed IP) and UTC day.
AI_USER_DAILY_LIMIT=12
AI_REFINE_USER_DAILY_LIMIT=40
# "0" / "off" turns every Claude call off without removing the key (kill switch).
# AI_FEATURES_ENABLED=1

# Prompt flow planner (defaults shown). Claude Haiku 5.5 is the cost/quality pick.
# AI_FLOW_MODEL=claude-haiku-5-5
# AI_FLOW_MAX_TOKENS=3500
# AI_FLOW_EFFORT=low
# AI_FLOW_TIMEOUT_MS=25000

# Analyzer rewrite (refiner) — existing since v1.8.0. Order of providers tried.
# REFINER_PROVIDERS=groq,anthropic
# ANTHROPIC_REFINER_MODEL=claude-haiku-5-5
# PROMPT_JUDGE_ENABLED=0

# Local development only: an in-memory ledger instead of Firestore (refused in production).
# AI_BUDGET_STORE=memory
# Local development only: a fixed "AI" flow so the page can be reviewed without a key.
# FLOW_DEV_FIXTURE=1

# ─── Already used before v1.8.9 (names only; see README) ────────────────────
# Firestore (ledger, telemetry, blog, newsletter)
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
# Ops: Vercel Cron and the read-only health/usage views
CRON_SECRET=
ROUTINE_HEALTH_SECRET=
ROUTINE_ALERT_TO=
# Groq (voice transcription, optional analyzer rewrite)
GROQ_API_KEY=
# Mail, publishing, social, SEO
RESEND_API_KEY=
BLOG_PUBLISH_SECRET=
NEWSLETTER_SEND_SECRET=
BUFFER_API_KEY=
INDEXNOW_KEY=
NEXT_PUBLIC_SITE_URL=https://www.promptea.me
