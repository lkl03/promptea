    "@vercel/analytics": "^1.6.1",
    "firebase-admin": "^14.5.1",
    "mcp-handler": "^2.4.0",
    "negotiator": "^1.0.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
